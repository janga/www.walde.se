---
import { getCollection } from 'astro:content';
import SiteNavigation from '../components/SiteNavigation.astro';
import SiteSection from '../components/SiteSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSectionHtml } from '../lib/sectionContent';

const [site] = await getCollection('site');

if (!site) {
	throw new Error('Innehållsfilen content/site.md saknas.');
}

const sections = site.data.sections;
const siteHtml = site.rendered?.html ?? '';
const sectionHtml = getSectionHtml(siteHtml, sections);
---

<BaseLayout title={site.data.title} description={site.data.description}>
	<SiteNavigation sections={sections} />

	<main id="main-content" class="site-content">
		{sections.map((section) => (
			<SiteSection section={section} contentHtml={sectionHtml[section.id] ?? ''} />
		))}
	</main>
</BaseLayout>
