---
import { getEntry, render } from 'astro:content';
import PageShell from '../components/PageShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'home');

if (!page) {
	throw new Error('Startsidesinnehållet content/pages/home.md saknas.');
}

const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
	<PageShell title={page.data.title}>
		<Content />
		<figure>
			<img
				src="/bilder/legacy/till-KIR-Karin-Walde-1.jpg"
				width="500"
				height="500"
				alt="Fossil 1"
				fetchpriority="high"
			/>
			<figcaption>Grafiskt verk</figcaption>
		</figure>
	</PageShell>
</BaseLayout>
