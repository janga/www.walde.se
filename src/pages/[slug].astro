---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Gallery from '../components/Gallery.astro';
import PageShell from '../components/PageShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

type PageEntry = CollectionEntry<'pages'>;
type GalleryEntry = CollectionEntry<'galleries'>;

type Props =
	| { kind: 'page'; entry: PageEntry }
	| { kind: 'gallery'; entry: GalleryEntry };

export async function getStaticPaths() {
	const [pages, galleries] = await Promise.all([
		getCollection('pages', ({ id }) => id !== 'home'),
		getCollection('galleries'),
	]);

	return [
		...pages.map((entry) => ({
			params: { slug: entry.id },
			props: { kind: 'page' as const, entry },
		})),
		...galleries.map((entry) => ({
			params: { slug: entry.id },
			props: { kind: 'gallery' as const, entry },
		})),
	];
}

const props = Astro.props as Props;
const pageContent = props.kind === 'page' ? await render(props.entry) : undefined;
const Content = pageContent?.Content;
---

<BaseLayout title={props.entry.data.title} description={props.entry.data.description}>
	<PageShell title={props.entry.data.title}>
		{props.kind === 'page' && Content ? (
			<Content />
		) : props.kind === 'gallery' ? (
			<Gallery
				placeholder={props.entry.data.placeholder}
				images={props.entry.data.images}
			/>
		) : null}
	</PageShell>
</BaseLayout>
