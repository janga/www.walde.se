---
import siteConfig from '../../site.config.json';

const currentSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'home';
const links = [
	{ title: 'hem', slug: 'home', href: '/' },
	...siteConfig.sections.map((section) => ({
		title: section.title,
		slug: section.slug,
		href: `/${section.slug}/`,
	})),
];
---

<a class="skip-link" href="#main-content">Hoppa till innehåll</a>

<nav class="navigation" aria-label="Huvudmeny">
	<ul class="desktop-menu">
		{links.map((link) => (
			<li>
				<a href={link.href} aria-current={currentSlug === link.slug ? 'page' : undefined}>
					{link.title}
				</a>
			</li>
		))}
	</ul>

	<details class="mobile-menu">
		<summary>
			<span class="menu-label">Meny</span>
			<span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
		</summary>
		<ul>
			{links.map((link) => (
				<li>
					<a href={link.href} aria-current={currentSlug === link.slug ? 'page' : undefined}>
						{link.title}
					</a>
				</li>
			))}
		</ul>
	</details>
</nav>

<style>
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 100;
		transform: translateY(-200%);
		background: #fff;
		color: #1d1d1d;
		padding: 0.75rem 1rem;
		font-weight: 700;
		text-decoration: none;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.navigation {
		position: relative;
		z-index: 3;
		background: #1d1d1d;
	}

	.desktop-menu {
		display: flex;
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.desktop-menu li {
		position: relative;
	}

	.desktop-menu li + li {
		margin-left: 2.5rem;
	}

	.desktop-menu li + li::before {
		position: absolute;
		top: 50%;
		left: -1.55rem;
		transform: translateY(-50%);
		color: #3d3d3d;
		content: "/";
		font-size: 0.875rem;
	}

	a {
		display: block;
		padding: 1.45rem 0;
		color: #999;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 0.15s ease;
	}

	a:hover,
	a[aria-current='page'] {
		color: #fff;
	}

	.mobile-menu {
		display: none;
	}

	@media (max-width: 900px) {
		.desktop-menu {
			display: none;
		}

		.mobile-menu {
			display: block;
		}

		summary {
			display: grid;
			min-height: 3rem;
			cursor: pointer;
			place-items: center;
			list-style: none;
		}

		summary::-webkit-details-marker {
			display: none;
		}

		.menu-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}

		.bars {
			display: grid;
			gap: 3px;
			width: 20px;
		}

		.bars i {
			display: block;
			height: 2px;
			background: #fff;
			border-radius: 2px;
		}

		.mobile-menu ul {
			margin: 0;
			border-top: 1px solid #2d2d2d;
			padding: 0.625rem 0;
			list-style: none;
		}

		.mobile-menu a {
			padding: 1rem 5%;
			color: #fff;
		}
	}
</style>
