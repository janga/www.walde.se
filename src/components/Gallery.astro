---
interface GalleryImage {
	file: string;
	title: string;
	alt: string;
	caption?: string;
	year?: string | number;
	order: number;
}

interface Props {
	placeholder: string;
	images: GalleryImage[];
}

const { placeholder, images } = Astro.props;
---

{images.length === 0 ? (
	<p>{placeholder}</p>
) : (
	<div class="gallery">
		{images.toSorted((a, b) => a.order - b.order).map((image) => (
			<article>
				<h3>{image.title}</h3>
				<p>{image.alt}</p>
				{image.caption && <p>{image.caption}</p>}
			</article>
		))}
	</div>
)}

<style>
	.gallery {
		display: grid;
		gap: 2rem;
	}

	article {
		border-top: 1px solid #ddd;
		padding-top: 1rem;
	}

	h3,
	p {
		margin-block: 0 0.5rem;
	}
</style>
