---
import type { CollectionEntry } from 'astro:content';
import { getImageAttributes } from '../lib/generatedImages';

type SiteSection = CollectionEntry<'site'>['data']['sections'][number];
type GalleryImage = SiteSection['gallery'][number];

interface Props {
	title: string;
	images: GalleryImage[];
}

const { title, images } = Astro.props;

const getDetails = (image: GalleryImage) =>
	[image.title, image.year, image.technique, image.dimensions, image.sold ? 'Såld' : undefined]
		.filter(Boolean)
		.join(', ');

const hasMetadata = (image: GalleryImage) =>
	Boolean(getDetails(image));
---

<div class="gallery" aria-label={`Galleri: ${title}`}>
	{images.map((image) => (
		<article class="gallery-item">
			<a
				href={image.src}
				class="gallery-image-link"
			>
				<img
					{...getImageAttributes(image.src, '(max-width: 700px) 100vw, 900px')}
					alt={image.alt}
					loading="lazy"
				/>
			</a>
			{hasMetadata(image) && (
				<div class="gallery-meta">
					<div class="gallery-details">
						{getDetails(image) && <span>{getDetails(image)}</span>}
					</div>
				</div>
			)}
		</article>
	))}
</div>
