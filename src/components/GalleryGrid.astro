---
import type { CollectionEntry } from 'astro:content';

type SiteSection = CollectionEntry<'site'>['data']['sections'][number];
type GalleryImage = SiteSection['gallery'][number];

interface Props {
	title: string;
	images: GalleryImage[];
}

const { title, images } = Astro.props;

const getDetails = (image: GalleryImage) =>
	[image.year, image.technique, image.material, image.dimensions, image.edition, image.location, image.status]
		.filter(Boolean)
		.join(', ');
---

<div class="gallery" aria-label={`Galleri: ${title}`}>
	{images.map((image) => (
		<article class="gallery-item">
			<a
				href={image.src}
				class="gallery-lightbox-trigger"
				data-lightbox-src={image.src}
				data-lightbox-alt={image.alt}
				data-lightbox-title={image.title ?? ''}
			>
				<img src={image.src} alt={image.alt} loading="lazy" />
			</a>
			<div class="gallery-meta">
				{image.title && <h2>{image.title}</h2>}
				{getDetails(image) && <p class="meta-line">{getDetails(image)}</p>}
				{image.caption && <p>{image.caption}</p>}
				{image.text && <p>{image.text}</p>}
			</div>
		</article>
	))}
</div>
