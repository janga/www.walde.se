---
import siteConfig from '../../site.config.json';
import '../styles/global.css';
import { getGeneratedImage } from '../lib/generatedImages';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = siteConfig.siteName,
	description = 'Konstnären Karin Waldes officiella webbplats.',
} = Astro.props;

const backgroundImage = getGeneratedImage(siteConfig.backgroundImage);
const backgroundStyle = backgroundImage
	? [
		`--site-background-image: url("${backgroundImage.variants.at(-1)?.src ?? siteConfig.backgroundImage}")`,
		`--site-background-image-small: url("${backgroundImage.variants.find((variant) => variant.width >= 768)?.src ?? backgroundImage.variants[0]?.src ?? siteConfig.backgroundImage}")`,
	].join('; ')
	: `--site-background-image: url("${siteConfig.backgroundImage}")`;
const documentTitle = title === siteConfig.siteName || title.toLowerCase() === 'hem'
	? siteConfig.siteName
	: `${title} – ${siteConfig.siteName}`;
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{documentTitle}</title>
	</head>
	<body style={backgroundStyle}>
		<slot />
		<footer class="site-footer" aria-label="Copyright">
			<p>
				© Karin Walde. Bilder, konstverk och texter får inte användas utan tillstånd.
				<span lang="en">Images, artworks and texts may not be used without permission.</span>
			</p>
		</footer>
	</body>
</html>
