---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const siteName = 'Karin Walde';
const {
	title = siteName,
	description = 'Konstnären Karin Waldes officiella webbplats.',
} = Astro.props;

const documentTitle = title === siteName || title.toLowerCase() === 'hem'
	? siteName
	: `${title} – ${siteName}`;
const buildTime = new Intl.DateTimeFormat('sv-SE', {
	dateStyle: 'short',
	timeStyle: 'short',
	timeZone: 'Europe/Stockholm',
}).format(new Date());
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href="https://www.walde.se/" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{documentTitle}</title>
	</head>
	<body>
		<slot />
		<footer class="site-footer" aria-label="Copyright">
			<p>
				© Karin Walde. Bilder, konstverk och texter får inte användas utan tillstånd.
				<span>Byggd {buildTime}</span>
			</p>
		</footer>
	</body>
</html>
